NEXT_PUBLIC_WALLET_CONNECT_ID=675ab88c974b1d13ffc2fe0bc470bf1a
NEXT_PUBLIC_RPC_OVERRIDES='{"chain1":{"http":"https://..."}}'

# AWS S3 Font Storage (server-side only, used by prebuild script)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# LcaiZap address override. Built-in defaults: Sepolia 0xEdeCE82309F12a1cb17eEe9DdDF095e845aEC49e, mainnet 0x91961D28700c6524C74C4C660A3EA236550d0b27
NEXT_PUBLIC_LCAI_ZAP_ADDRESS=

# testnet (default: Sepolia <-> Lightchain testnet, LcaiZap 0xEdeCE82309F12a1cb17eEe9DdDF095e845aEC49e) or mainnet
NEXT_PUBLIC_NETWORK=testnet
